{
  "manifest_version": 3,
  "name": "Pointer",
  "version": "0.1.0",
  "description": "Click any element and hand its DOM, styles, screenshot and source location to your coding agent. Local only.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pointer: pick an element" },
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Pick an element on this page"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
