{
  "name": "pointer-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter pointer-extension build && pnpm --filter pointer-bridge build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter pointer-examples test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghavendra7533/pointer.git"
  },
  "homepage": "https://github.com/raghavendra7533/pointer#readme",
  "bugs": {
    "url": "https://github.com/raghavendra7533/pointer/issues"
  }
}
